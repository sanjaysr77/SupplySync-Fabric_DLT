# HTTP (default 5000; network docs also reference port 3000 for a gateway UI)
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hyperledger-fabric-trial
JWT_SECRET=replace-with-a-long-random-string

# Fabric — paths relative to backend/ match network/scripts (organizations under network/)
# Peer org crypto root (e.g. retailer for default client); orderer TLS CA lives under ordererOrganizations
FABRIC_PEER_HOST=localhost:7051
CRYPTO_PATH=../network/organizations/peerOrganizations/retailer.example.com
ORDERER_CRYPTO_PATH=../network/organizations/ordererOrganizations/example.com

# Channel / chaincodes (network/scripts/deploy-channels.sh, deploy-chaincodes.sh)
FABRIC_CHANNEL_ID=mychannel

# Node on host + Fabric in Docker: use localhost gRPC + discovery asLocalhost (fixes "DiscoveryService has failed")
FABRIC_USE_LOCALHOST_GRPC=true
FABRIC_DISCOVERY_AS_LOCALHOST=true
# Set FABRIC_DISCOVERY_ENABLED=false to force static CCP only (if discovery still fails)

# CORS: Vite default + optional CRA/network doc port (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Email (nodemailer); legacy names still supported in code if you add aliases later
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
